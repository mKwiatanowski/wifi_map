# Copy to .env and fill in secrets. All values are read with the HOMESENSE_ prefix.
HOMESENSE_MODE=live
HOMESENSE_DATA_DIR=data
HOMESENSE_HOST=0.0.0.0
HOMESENSE_PORT=8080
HOMESENSE_TIMEZONE=Europe/Warsaw
HOMESENSE_SECRET_KEY=

HOMESENSE_ROUTER_ENABLED=true
HOMESENSE_ROUTER_HOST=192.168.0.1
HOMESENSE_ROUTER_USERNAME=admin
HOMESENSE_ROUTER_PASSWORD=
HOMESENSE_ROUTER_INTERVAL_S=60

HOMESENSE_ARP_ENABLED=true
HOMESENSE_ARP_SUBNET=192.168.0.0/24
HOMESENSE_ARP_INTERVAL_S=120

HOMESENSE_ADGUARD_ENABLED=true
HOMESENSE_ADGUARD_URL=http://127.0.0.1:3001
HOMESENSE_ADGUARD_USERNAME=
HOMESENSE_ADGUARD_PASSWORD=
HOMESENSE_ADGUARD_INTERVAL_S=30

HOMESENSE_GRAFANA_URL=http://127.0.0.1:3000

HOMESENSE_DEPARTURE_TIMEOUT_MIN=15
HOMESENSE_RETENTION_DAYS=30

HOMESENSE_WINDOWS_TOAST=true
HOMESENSE_TELEGRAM_BOT_TOKEN=
HOMESENSE_TELEGRAM_CHAT_ID=
HOMESENSE_NTFY_URL=https://ntfy.sh
HOMESENSE_NTFY_TOPIC=

HOMESENSE_QUIET_HOURS_START=23
HOMESENSE_QUIET_HOURS_END=7
HOMESENSE_SIM_SEED=42
